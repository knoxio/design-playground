# Cloudflare Access service token (Zero Trust -> Access -> Service tokens).
# Used twice: /apply-feedback reaches the feedback API from a local session,
# and the dev server proxies /api/* to the deployed service with these
# headers, so the threads tool works on localhost (secrets stay server-side).
# Copy to .env (gitignored); never commit real values.
# DP_FEEDBACK_URL is the deployed internal app's /api base; point it at your
# own deployment (see docs/guides/cloudflare-setup.md).
CF_ACCESS_CLIENT_ID=xxxxxxxx.access
CF_ACCESS_CLIENT_SECRET=xxxxxxxxxxxxxxxx
DP_FEEDBACK_URL=https://<your-internal-app>.pages.dev/api
